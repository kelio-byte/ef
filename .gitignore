# Python caches and build artifacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/

# Jupyter and editor state
.ipynb_checkpoints/
**/.ipynb_checkpoints/
.claude/
.vscode/
.idea/

# Local environments and secrets
.env
.env.*
!.env.example
.venv/
venv/

# Model weights and large archives
*.pt
*.pth
*.ckpt
*.zip
*.tar
*.tar.gz

# Local datasets, generated predictions, and visualizations
# Keep all datasets local except the versioned SPE corpus required for
# reproducible retrosynthesis training and evaluation.
datasets/*
!datasets/USPTO_50K_PtoR_aug20_#global#_SPE/
!datasets/USPTO_50K_PtoR_aug20_#global#_SPE/**
!datasets/USPTO_50K_PtoR_aug20_SPE_m500/
!datasets/USPTO_50K_PtoR_aug20_SPE_m500/**
!datasets/USPTO_50K_PtoR_aug20_SPE_full/
!datasets/USPTO_50K_PtoR_aug20_SPE_full/**
# Dataset allow-rules above must not re-include notebook autosaves.
datasets/**/.ipynb_checkpoints/
datasets/USPTO_50K_PtoR_aug20_#global#_SPE/.ipynb_checkpoints/
datasets/USPTO_50K_PtoR_aug20_#global#_SPE/*/.ipynb_checkpoints/
results/
# Compact, reviewable Stage reports belong with the After-SPE documentation.
!after_spe/results/
!after_spe/results/**
# The broad report allow-rule above must not re-include notebook autosaves.
after_spe/results/**/.ipynb_checkpoints/
visualizations/
analysis_outputs/
test_sample/

# Runtime output
*.log
logs/
checkpoints/
start.txt

# Independent SPE pilot runtime artifacts (weights and logs stay local)
checkpoints/retro_spe_pilot/

# OS files
.DS_Store
Thumbs.db
